root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.go,go.mod,go.sum,Makefile}]
indent_style = tab

[*.{yaml,yml,json,md,nix,py}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Recorded output: every byte is part of the fixture.
[{testdata/**,internal/demo/data/**,docs/screenshots/**}]
trim_trailing_whitespace = false
insert_final_newline = unset
