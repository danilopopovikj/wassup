{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wassup.dev/schema/annotations.json",
  "title": "wassup state/annotations.json",
  "type": "object",
  "required": ["version", "annotations"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "note": { "type": "string" },
          "confidence": { "enum": ["low", "medium", "high"] },
          "source": { "type": "string" },
          "created_at": { "type": "string" },
          "expires_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
